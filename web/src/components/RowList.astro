---
const { items, stacked = false } = Astro.props;
---
<div class="row-list">
  {items.map((item) => (
    <a class:list={['row', stacked && 'row--stack']} href={item.href ?? '#'}>
      <span class="row-left">
        <span class="row-index">{item.index}</span>
        <span class="row-title">{item.title}</span>
      </span>
      <span class="row-right">
        {item.meta && <span class="row-meta">{item.meta}</span>}
        <svg
          class="row-arrow"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </span>
    </a>
  ))}
</div>
